# Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Render provides this automatically if you attach a Postgres database.
# For local dev, point it at a local Postgres instance.
DATABASE_URL=postgres://user:password@localhost:5432/aligntrack

# Any long random string - used to sign session cookies
SESSION_SECRET=change_this_to_a_long_random_string

# The first invite code created on first boot (role: admin). Share this once,
# then create more codes directly in the invite_codes table as needed.
SEED_INVITE_CODE=WELCOME2026

PORT=10000
NODE_ENV=production
